{
  "buildCommand": "pnpm install && pnpm run build",
  "outputDirectory": "dist",
  "public": true,
  "env": {
    "VITE_YOUTUBE_API_KEY": "@VITE_YOUTUBE_API_KEY",
    "VITE_YOUTUBE_CHANNEL_ID": "@VITE_YOUTUBE_CHANNEL_ID"
  },
  "headers": [
    {
      "source": "/img/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
